
# Application
APP_NAME=CampusGuide
APP_ENV=development
DEBUG=true

# API
HOST=127.0.0.1
PORT=8000
API_PREFIX=/api/v1

# NLP
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2

# Text chunking
CHUNK_SIZE=800
CHUNK_OVERLAP=120

# Retrieval
RETRIEVAL_TOP_K=5

# Vector database
CHROMA_COLLECTION_NAME=campusguide_documents

# LLM (optional)
LLM_PROVIDER=none
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Upload
MAX_UPLOAD_SIZE_MB=25
MIN_RETRIEVAL_SIMILARITY=0.35
